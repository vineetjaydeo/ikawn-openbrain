{
  "name": "ikawn-openbrain",
  "version": "3.0.1",
  "description": "iKawn's Enterprise AI Intelligence Layer — memory, RAG, chat, agent platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:mcp": "node src/mcp/server.js",
    "init-db": "node scripts/init-db.js",
    "sync-github": "node scripts/sync-github.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "pre-deploy": "bash scripts/pre-deploy.sh",
    "backfill": "node scripts/backfill-supabase.js",
    "reconcile": "node scripts/reconcile-counts.js",
    "reembed": "node scripts/reembed-supabase.js",
    "dev:frontend": "cd src/frontend && npx vite",
    "build:frontend": "cd src/frontend && npx vite build",
    "dev:all": "concurrently \"node src/index.js\" \"cd src/frontend && npx vite\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-s3": "^3.1002.0",
    "@aws-sdk/s3-request-presigner": "^3.1002.0",
