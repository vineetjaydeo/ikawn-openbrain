    "@modelcontextprotocol/sdk": "^1.12.1",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "concurrently": "^9.1.0",
    "cookie-session": "^2.1.1",
    "croner": "^10.0.1",
    "eventemitter2": "^6.4.9",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.0",
    "googleapis": "^171.4.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "openai": "^4.73.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.0",
    "resend": "^6.9.3",
    "sharp": "^0.34.5",
